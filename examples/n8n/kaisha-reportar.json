{
  "name": "Kaisha · Reportar Status",
  "nodes": [
    {
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            { "name": "agent" },
            { "name": "status" },
            { "name": "task" },
            { "name": "queue", "type": "number" }
          ]
        }
      },
      "name": "Receber Status",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://kaisha.seudominio.com/api/events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ agent: $json.agent, status: $json.status || 'working', task: $json.task || null, queue: $json.queue || null }) }}",
        "options": { "timeout": 3000 }
      },
      "name": "Enviar ao Kaisha",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Receber Status": { "main": [[{ "node": "Enviar ao Kaisha", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
